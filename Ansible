---
- name: CIS Hardening Playbook
  hosts: all
  become: yes
  gather_facts: false
  strategy: free

  tasks:

    - name: Copy CIS modprobe.d conf
      copy:
        src: /etc/modprobe.d/CIS.conf
        dest: /etc/modprobe.d/CIS.conf

    - name: Set correct permissions on CIS.conf
      shell: chmod 644 /etc/modprobe.d/CIS.conf

    - name: Remove /etc/at.deny
      shell: rm -f /etc/at.deny

    - name: Enable crond service
      shell: systemctl enable crond.service

    - name: Ensure /etc/dconf/db/gdm.d directory exists
      file:
        path: /etc/dconf/db/gdm.d
        state: directory
        mode: '0755'

    - name: Ensure GDM login banner message file is correctly configured
      copy:
        dest: /etc/dconf/db/gdm.d/01-banner-message
        content: |
          [org/gnome/login-screen]
          banner-message-enable=true
          banner-message-text='WARNING: This system is for the use of authorized users for authorized purposes only. Activities on this system are being recorded and monitored by the Bank. Individuals, using this system without authority, or in excess of their authority shall be treated as having violated the IT Policy and IS Policy of the Bank and, are subject to legal/disciplinary actions as per the policy of the Bank.'

    - name: Run dconf update to apply banner message
      shell: dconf update
      ignore_errors: true

    - name: Ensure reference authselect snippet directory exists (for record keeping)
      shell: mkdir -p /etc/authselect/custom/sssd

    - name: Copy reference password-auth snippet
      copy:
        src: /etc/authselect/custom/sssd/password-auth
        dest: /etc/authselect/custom/sssd/password-auth

    - name: Copy reference system-auth snippet
      copy:
        src: /etc/authselect/custom/sssd/system-auth
        dest: /etc/authselect/custom/sssd/system-auth

    - name: Select authselect sssd profile with faillock and pwhistory
      shell: authselect select sssd with-faillock with-pwhistory --force
      ignore_errors: true

    - name: Apply authselect changes
      shell: authselect apply-changes
      ignore_errors: true

    - name: Add AIDE check cron job
      cron:
        name: "side check job"
        minute: "0"
        hour: "5"
        job: "/usr/sbin/aide --check"

    - name: Update /tmp mount options in fstab (nodev,nosuid,noexec)
      shell: >
        sed -i 's|/dev/mapper/rhel-tmp[[:space:]]\+/tmp[[:space:]]\+xfs[[:space:]]\+defaults[[:space:]]\+0[[:space:]]\+0|/dev/mapper/rhel-tmp   /tmp    xfs   defaults,nodev,nosuid,noexec 0 0|' /etc/fstab

    - name: Add hardened tmpfs entry for /dev/shm in fstab
      lineinfile:
        path: /etc/fstab
        regexp: '^tmpfs\s+/dev/shm\s+'
        line: "tmpfs   /dev/shm    tmpfs   defaults,nodev,nosuid,noexec   0 0"
        state: present

    - name: Set pwquality minlen to 14
      replace:
        path: /etc/security/pwquality.conf
        regexp: '^#?[ \t]*minlen[ \t]*=[ \t]*\d+'
        replace: 'minlen = 14'

    - name: Set pwquality retry to 3
      replace:
        path: /etc/security/pwquality.conf
        regexp: '^#?[ \t]*retry[ \t]*=[ \t]*\d+'
        replace: 'retry = 3'

    - name: Set pwquality minclass to 4
      replace:
        path: /etc/security/pwquality.conf
        regexp: '^#?[ \t]*minclass[ \t]*=[ \t]*\d+'
        replace: 'minclass = 4'

    - name: Set pwhistory remember to 5
      replace:
        path: /etc/security/pwhistory.conf
        regexp: '#\s*remember\s*=\s*10'
        replace: 'remember = 5'

    - name: Set faillock deny to 5
      replace:
        path: /etc/security/faillock.conf
        regexp: '#\s*deny\s*=\s*3'
        replace: 'deny = 5'

    - name: Set faillock unlock_time to 900
      replace:
        path: /etc/security/faillock.conf
        regexp: '#\s*unlock_time\s*=\s*600'
        replace: 'unlock_time = 900'

    - name: Enable faillock audit
      replace:
        path: /etc/security/faillock.conf
        regexp: '#\s*audit'
        replace: 'audit'

    - name: Enable faillock silent
      replace:
        path: /etc/security/faillock.conf
        regexp: '#\s*silent'
        replace: 'silent'

    - name: Remove duplicate lines from PAM config files
      shell: awk '!seen[$0]++' {{ item }} > {{ item }}.tmp && mv {{ item }}.tmp {{ item }}
      loop:
        - /etc/security/pwquality.conf
        - /etc/security/pwhistory.conf
        - /etc/security/faillock.conf

    - name: Remove xorg-x11 packages only (without removing dependents like java)
      shell: |
        pkgs=$(rpm -qa 'xorg-x11*')
        if [ -n "$pkgs" ]; then
          rpm -e --nodeps $pkgs && echo REMOVED
        fi
      register: xorg_remove
      changed_when: "'REMOVED' in xorg_remove.stdout"

    - name: Reload systemd daemon
      shell: systemctl daemon-reload

    - name: Remount /tmp
      shell: mount -o remount /tmp

    - name: Remount /dev/shm
      shell: mount -o remount /dev/shm

    - name: Copy compliant sshd_config from Ansible control node
      copy:
        src: /etc/ssh/sshd_config
        dest: /etc/ssh/sshd_config
        owner: root
        group: root
        mode: '0600'
        validate: /usr/sbin/sshd -t -f %s
      register: sshd_config_copy

    - name: Ensure all files under /etc/ssh are owned by root:root
      shell: find /etc/ssh ! \( -user root -group root \) -print -exec chown -h root:root {} \;
      register: ssh_owner
      changed_when: 'ssh_owner.stdout != ""'

    - name: Ensure SSH private host keys have 0600 permissions
      shell: find /etc/ssh -maxdepth 1 -type f -name 'ssh_host_*_key' ! -perm 0600 -print -exec chmod 0600 {} \;
      register: ssh_priv_perm
      changed_when: 'ssh_priv_perm.stdout != ""'

    - name: Ensure SSH public host keys have 0644 permissions
      shell: find /etc/ssh -maxdepth 1 -type f -name 'ssh_host_*_key.pub' ! -perm 0644 -print -exec chmod 0644 {} \;
      register: ssh_pub_perm
      changed_when: 'ssh_pub_perm.stdout != ""'

    - name: Restart sshd to apply new config
      shell: systemctl restart sshd
      when: sshd_config_copy.changed

    - name: Remove old custom sysctl hardening file if present
      file:
        path: /etc/sysctl.d/99-custom-hardening.conf
        state: absent

    - name: Set required network sysctl parameters in /etc/sysctl.conf
      lineinfile:
        path: /etc/sysctl.conf
        regexp: "^{{ item.name }}\\s*="
        line: "{{ item.name }} = {{ item.value }}"
        state: present
      loop:
        - { name: "net.ipv4.conf.all.rp_filter", value: "1" }
        - { name: "net.ipv4.conf.default.rp_filter", value: "1" }
        - { name: "net.ipv4.conf.all.send_redirects", value: "0" }
        - { name: "net.ipv4.conf.default.send_redirects", value: "0" }
        - { name: "net.ipv4.icmp_ignore_bogus_error_responses", value: "1" }
        - { name: "net.ipv4.ip_forward", value: "0" }
        - { name: "net.ipv4.tcp_syncookies", value: "1" }

    - name: Reload all sysctl settings (system-wide)
      shell: sysctl --system

    - name: Stop and disable avahi-daemon service
      shell: systemctl stop avahi-daemon.socket avahi-daemon.service; systemctl disable avahi-daemon.socket avahi-daemon.service
      ignore_errors: true

    - name: Remove avahi packages only (without removing dependents like java)
      shell: |
        pkgs=$(rpm -qa 'avahi*')
        if [ -n "$pkgs" ]; then
          rpm -e --nodeps $pkgs && echo REMOVED
        fi
      register: avahi_remove
      changed_when: "'REMOVED' in avahi_remove.stdout"

    - name: Copy audit.rules to remote hosts
      copy:
        src: /etc/audit/rules.d/audit.rules
        dest: /etc/audit/rules.d/audit.rules

    - name: Copy audit.rules to remote hosts
      copy:
        src: /etc/audit/auditd.conf
        dest: /etc/audit/auditd.conf

    - name: Fix invalid auid!=unaudited syntax in audit.rules
      replace:
        path: /etc/audit/rules.d/audit.rules
        regexp: 'auid!=unaudited'
        replace: 'auid!=4294967295'

    - name: Remove duplicate lines from audit.rules
      shell: awk '!seen[$0]++' /etc/audit/rules.d/audit.rules > /etc/audit/rules.d/audit.rules.tmp && mv /etc/audit/rules.d/audit.rules.tmp /etc/audit/rules.d/audit.rules

    - name: Restart auditd to load new audit rules
      shell: service auditd restart

    - name: Set coredump Storage to none
      lineinfile:
        path: /etc/systemd/coredump.conf
        regexp: '^#?\s*Storage\s*='
        line: 'Storage=none'
        insertafter: '^\[Coredump\]'

    - name: Set coredump ProcessSizeMax to 0
      lineinfile:
        path: /etc/systemd/coredump.conf
        regexp: '^#?\s*ProcessSizeMax\s*='
        line: 'ProcessSizeMax=0'
        insertafter: '^\[Coredump\]'

    - name: Stop and disable cups service
      shell: systemctl stop cups; systemctl disable cups
      ignore_errors: true

    - name: Remove cups packages only (without removing dependents like java)
      shell: |
        pkgs=$(rpm -qa 'cups*')
        if [ -n "$pkgs" ]; then
          rpm -e --nodeps $pkgs && echo REMOVED
        fi
      register: cups_remove
      changed_when: "'REMOVED' in cups_remove.stdout"

    - name: Set password aging defaults in login.defs
      lineinfile:
        path: /etc/login.defs
        regexp: '^\s*{{ item.key }}\s+'
        line: '{{ item.key }}   {{ item.value }}'
      loop:
        - { key: PASS_MAX_DAYS, value: 90 }
        - { key: PASS_MIN_DAYS, value: 7 }
        - { key: PASS_WARN_AGE, value: 14 }

    - name: Set INACTIVE=30 in /etc/default/useradd
      lineinfile:
        path: /etc/default/useradd
        regexp: '^\s*INACTIVE\s*='
        line: 'INACTIVE=30'

    - name: Set shell idle timeout TMOUT=900
      copy:
        dest: /etc/profile.d/tmout.sh
        owner: root
        group: root
        mode: '0644'
        content: |
          TMOUT=900
          export TMOUT

    - name: Set TMOUT=900 in /etc/bashrc
      lineinfile:
        path: /etc/bashrc
        regexp: '^\s*(readonly\s+)?TMOUT\s*='
        line: 'TMOUT=900'
        insertafter: EOF

    - name: Enforce password aging policy (min 7, max 90, warn 14) for normal users
      shell: |
        for user in $(awk -F: '($3>=1000)&&($3!=65534){print $1}' /etc/passwd); do
          current_min=$(chage -l "$user" | awk -F': ' '/Minimum number of days between password change/{print $2}')
          current_max=$(chage -l "$user" | awk -F': ' '/Maximum number of days between password change/{print $2}')
          current_warn=$(chage -l "$user" | awk -F': ' '/Number of days of warning before password expires/{print $2}')
          if [ "$current_min" != "7" ] || [ "$current_max" != "90" ] || [ "$current_warn" != "14" ]; then
            chage -m 7 -M 90 -W 14 "$user"
          fi
        done

    - name: Enforce password aging policy for root users
      shell: |
        current_min=$(chage -l root | awk -F': ' '/Minimum number of days between password change/{print $2}')
        current_max=$(chage -l root | awk -F': ' '/Maximum number of days between password change/{print $2}')
        current_warn=$(chage -l root | awk -F': ' '/Number of days of warning before password expires/{print $2}')
        if [ "$current_min" != "7" ] || [ "$current_max" != "90" ] || [ "$current_warn" != "14" ]; then
          chage -m 7 -M 90 -W 14 root
        fi

    - name: Remove /etc/cron.deny if present
      file:
        path: /etc/cron.deny
        state: absent

    - name: Create /etc/cron.allow only if missing
      copy:
        content: ""
        dest: /etc/cron.allow
        force: no
        owner: root
        group: root
        mode: '0640'

    - name: Secure cron files and directories (root:root, og-rwx)
      file:
        path: "{{ item.path }}"
        state: "{{ item.state }}"
        owner: root
        group: root
        mode: "{{ item.mode }}"
      loop:
        - { path: /etc/crontab, state: file, mode: '0600' }
        - { path: /etc/cron.allow, state: file, mode: '0640' }
        - { path: /etc/cron.d, state: directory, mode: '0700' }
        - { path: /etc/cron.daily, state: directory, mode: '0700' }
        - { path: /etc/cron.hourly, state: directory, mode: '0700' }
        - { path: /etc/cron.monthly, state: directory, mode: '0700' }
        - { path: /etc/cron.weekly, state: directory, mode: '0700' }

    - name: Check if grub.cfg exists
      stat:
        path: /boot/grub2/grub.cfg
      register: grub_cfg_stat

    - name: Generate grub.cfg if missing
      shell: grub2-mkconfig -o /boot/grub2/grub.cfg
      when: not grub_cfg_stat.stat.exists

    - name: Set correct ownership and permissions on grub.cfg
      file:
        path: /boot/grub2/grub.cfg
        owner: root
        group: root
        mode: '0600'

    - name: Check if grubenv exists
      stat:
        path: /boot/grub2/grubenv
      register: grubenv_stat

    - name: Set correct ownership and permissions on grubenv
      file:
        path: /boot/grub2/grubenv
        owner: root
        group: root
        mode: '0600'
      when: grubenv_stat.stat.exists

    - name: Disable named (BIND) service (no stop, no package removal)
      shell: systemctl disable named
      ignore_errors: true

    - name: Disable rpcbind service (no stop, no package removal)
      shell: systemctl disable rpcbind
      ignore_errors: true

    - name: Stop and disable telnet service
      shell: systemctl stop telnet.socket; systemctl disable telnet.socket
      ignore_errors: true

    - name: Remove telnet packages
      shell: yum remove -y telnet telnet-server
      ignore_errors: true



#!/usr/bin/env bash
# Local Bash equivalent of the supplied /opt/scd/cis_hardening.yml.
# Review and test on UAT before production use. Run as root.
set -Eeuo pipefail
umask 077
LOG="/var/log/cis_hardening_$(date +%Y%m%d_%H%M%S).log"
exec > >(tee -a "$LOG") 2>&1

if [[ ${EUID} -ne 0 ]]; then echo "ERROR: Run as root." >&2; exit 1; fi
if [[ ${1:-} == "--help" ]]; then echo "Usage: $0 [--yes]  Default is interactive; --yes skips confirmation."; exit 0; fi
if [[ ${1:-} != "--yes" ]]; then
  echo "WARNING: This script modifies security/authentication, SSH, audit, mount, sysctl, package and service settings."
  echo "Log: $LOG"
  read -r -p "Continue on this server? Type YES: " answer
  [[ "$answer" == "YES" ]] || { echo "Cancelled."; exit 1; }
fi

backup_file() { local f="$1"; if [[ -e "$f" && ! -e "$f.cisbak" ]]; then cp -a -- "$f" "$f.cisbak"; fi; }
ensure_line() { local file="$1" key="$2" value="$3"; touch "$file"; backup_file "$file"; if grep -Eq "^[[:space:]]*${key}[[:space:]]*=" "$file"; then sed -ri "s|^[[:space:]]*${key}[[:space:]]*=.*|${key} = ${value}|" "$file"; else printf '\n%s = %s\n' "$key" "$value" >> "$file"; fi; }

run_if_exists() { local desc="$1"; shift; if "$@"; then :; else echo "WARNING: $desc failed (continuing where possible)."; fi; }

# 1. Modprobe config: the Ansible source and destination are the same local path.
if [[ -f /etc/modprobe.d/CIS.conf ]]; then chmod 0644 /etc/modprobe.d/CIS.conf; else echo "WARNING: /etc/modprobe.d/CIS.conf not found; no file copied."; fi
rm -f /etc/at.deny
systemctl enable crond.service

# 2. GDM banner. dconf update may be unavailable on headless servers.
install -d -m 0755 /etc/dconf/db/gdm.d
cat > /etc/dconf/db/gdm.d/01-banner-message <<'BANNER'
[org/gnome/login-screen]
banner-message-enable=true
banner-message-text='WARNING: This system is for the use of authorized users for authorized purposes only. Activities on this system are being recorded and monitored by the Bank. Individuals, using this system without authority, or in excess of their authority shall be treated as having violated the IT Policy and IS Policy of the Bank and, are subject to legal/disciplinary actions as per the policy of the Bank.'
BANNER
chmod 0644 /etc/dconf/db/gdm.d/01-banner-message
run_if_exists "dconf update" dconf update

# 3. Authselect. NOTE: the original playbook's copy source/destination are identical;
# these commands only create the reference directory and select the requested profile.
install -d -m 0755 /etc/authselect/custom/sssd
if command -v authselect >/dev/null 2>&1; then
  run_if_exists "authselect select" authselect select sssd with-faillock with-pwhistory --force
  run_if_exists "authselect apply-changes" authselect apply-changes
else echo "WARNING: authselect not installed."; fi

# 4. AIDE cron at 05:00 daily (avoid duplicate entry).
if command -v crontab >/dev/null 2>&1; then
  (crontab -l 2>/dev/null | grep -Fv '# CIS: aide check'; echo '0 5 * * * /usr/sbin/aide --check # CIS: aide check') | crontab -
else echo "WARNING: crontab command not found; AIDE cron not added."; fi

# 5. /tmp and /dev/shm fstab settings. Back up before edits.
if [[ -f /etc/fstab ]]; then
  backup_file /etc/fstab
  if grep -Eq '^/dev/mapper/rhel-tmp[[:space:]]+/tmp[[:space:]]+xfs[[:space:]]+defaults([[:space:]]|$)' /etc/fstab; then
    sed -ri 's|^(/dev/mapper/rhel-tmp[[:space:]]+/tmp[[:space:]]+xfs[[:space:]]+)defaults([[:space:]]+0[[:space:]]+0.*)$|\1defaults,nodev,nosuid,noexec 0 0|' /etc/fstab
  else echo "INFO: Expected /tmp fstab entry not found; not rewritten automatically."; fi
  if grep -Eq '^tmpfs[[:space:]]+/dev/shm[[:space:]]+' /etc/fstab; then
    sed -ri 's|^tmpfs[[:space:]]+/dev/shm[[:space:]]+.*$|tmpfs   /dev/shm    tmpfs   defaults,nodev,nosuid,noexec   0 0|' /etc/fstab
  else echo 'tmpfs   /dev/shm    tmpfs   defaults,nodev,nosuid,noexec   0 0' >> /etc/fstab; fi
fi

# 6. Password quality/history/faillock configuration.
for f in /etc/security/pwquality.conf /etc/security/pwhistory.conf /etc/security/faillock.conf; do
  [[ -e "$f" ]] && backup_file "$f" || { install -m 0644 /dev/null "$f"; }
done
set_conf_value() { local file="$1" key="$2" value="$3"; if grep -Eq "^[[:space:]#]*${key}[[:space:]]*=" "$file"; then sed -ri "s|^[[:space:]#]*${key}[[:space:]]*=.*|${key} = ${value}|" "$file"; else printf '%s = %s\n' "$key" "$value" >> "$file"; fi; }
set_conf_value /etc/security/pwquality.conf minlen 14
set_conf_value /etc/security/pwquality.conf retry 3
set_conf_value /etc/security/pwquality.conf minclass 4
set_conf_value /etc/security/pwhistory.conf remember 5
set_conf_value /etc/security/faillock.conf deny 5
set_conf_value /etc/security/faillock.conf unlock_time 900
# Use explicit enabled settings rather than relying on commented defaults.
set_conf_value /etc/security/faillock.conf audit ""
set_conf_value /etc/security/faillock.conf silent ""
for f in /etc/security/pwquality.conf /etc/security/pwhistory.conf /etc/security/faillock.conf; do
  awk '!seen[$0]++' "$f" > "$f.tmp" && cat "$f.tmp" > "$f" && rm -f "$f.tmp"
done

# 7. Remove xorg-x11 packages (the original playbook uses --nodeps; high risk).
# Safer default: report packages and require explicit opt-in to erase.
if rpm -qa 'xorg-x11*' | grep -q .; then
  echo "WARNING: xorg-x11 packages are installed. They are NOT removed automatically by this script."
  echo "Review with: rpm -qa 'xorg-x11*' ; remove manually only after impact assessment."
fi

systemctl daemon-reload
run_if_exists "remount /tmp" mount -o remount /tmp
run_if_exists "remount /dev/shm" mount -o remount /dev/shm

# 8. SSH configuration. Original Ansible copy source/destination are the same local file.
# Do not overwrite sshd_config from another host; validate current config and fix ownership/modes.
if [[ -f /etc/ssh/sshd_config ]]; then
  backup_file /etc/ssh/sshd_config
  chmod 0600 /etc/ssh/sshd_config
  if command -v sshd >/dev/null 2>&1; then sshd -t -f /etc/ssh/sshd_config; fi
fi
find /etc/ssh ! \( -user root -group root \) -print -exec chown -h root:root {} \;
find /etc/ssh -maxdepth 1 -type f -name 'ssh_host_*_key' ! -perm 0600 -print -exec chmod 0600 {} \;
find /etc/ssh -maxdepth 1 -type f -name 'ssh_host_*_key.pub' ! -perm 0644 -print -exec chmod 0644 {} \;
# Restart only if config validates; existing sessions should remain but new SSH access may be affected.
if command -v sshd >/dev/null 2>&1 && sshd -t -f /etc/ssh/sshd_config; then run_if_exists "restart sshd" systemctl restart sshd; fi

# 9. Network sysctl settings. WARNING: ip_forward=0 may break router/container/registry networking.
rm -f /etc/sysctl.d/99-custom-hardening.conf
backup_file /etc/sysctl.conf
ensure_line /etc/sysctl.conf net.ipv4.conf.all.rp_filter 1
ensure_line /etc/sysctl.conf net.ipv4.conf.default.rp_filter 1
ensure_line /etc/sysctl.conf net.ipv4.conf.all.send_redirects 0
ensure_line /etc/sysctl.conf net.ipv4.conf.default.send_redirects 0
ensure_line /etc/sysctl.conf net.ipv4.icmp_ignore_bogus_error_responses 1
if [[ ${ALLOW_IP_FORWARD_DISABLE:-no} == yes ]]; then ensure_line /etc/sysctl.conf net.ipv4.ip_forward 0; else echo 'INFO: Skipping net.ipv4.ip_forward=0 to avoid disrupting container/registry networking. Set ALLOW_IP_FORWARD_DISABLE=yes only after approval.'; fi
ensure_line /etc/sysctl.conf net.ipv4.tcp_syncookies 1
run_if_exists "sysctl --system" sysctl --system

# 10. Disable/remove selected services/packages. Package removals use safer yum remove, not rpm --nodeps.
for svc in avahi-daemon.socket avahi-daemon.service; do run_if_exists "stop $svc" systemctl stop "$svc"; run_if_exists "disable $svc" systemctl disable "$svc"; done
if rpm -qa 'avahi*' | grep -q .; then echo 'INFO: avahi packages present; not force-removed. Review package dependencies before removal.'; fi

# Audit config copy tasks in the YAML are local source == destination; back up and fix invalid syntax.
if [[ -f /etc/audit/rules.d/audit.rules ]]; then
  backup_file /etc/audit/rules.d/audit.rules
  sed -i 's/auid!=unaudited/auid!=4294967295/g' /etc/audit/rules.d/audit.rules
  awk '!seen[$0]++' /etc/audit/rules.d/audit.rules > /etc/audit/rules.d/audit.rules.tmp
  cat /etc/audit/rules.d/audit.rules.tmp > /etc/audit/rules.d/audit.rules && rm -f /etc/audit/rules.d/audit.rules.tmp
fi
if [[ -f /etc/audit/auditd.conf ]]; then backup_file /etc/audit/auditd.conf; fi
if command -v service >/dev/null 2>&1; then run_if_exists "restart auditd" service auditd restart; fi

# 11. Disable core dump storage.
install -d -m 0755 /etc/systemd
for kv in 'Storage none' 'ProcessSizeMax 0'; do set -- $kv; key="$1"; val="$2"; file=/etc/systemd/coredump.conf; [[ -e $file ]] && backup_file "$file" || touch "$file"; if grep -Eq "^[[:space:]#]*${key}[[:space:]]*=" "$file"; then sed -ri "s|^[[:space:]#]*${key}[[:space:]]*=.*|${key}=${val}|" "$file"; else printf '\n[Coredump]\n%s=%s\n' "$key" "$val" >> "$file"; fi; done

run_if_exists 'stop cups' systemctl stop cups
run_if_exists 'disable cups' systemctl disable cups
if rpm -qa 'cups*' | grep -q .; then echo 'INFO: cups packages present; not force-removed. Review dependencies before removal.'; fi

# 12. Password aging defaults and per-user policy.
backup_file /etc/login.defs
ensure_line /etc/login.defs PASS_MAX_DAYS 90
ensure_line /etc/login.defs PASS_MIN_DAYS 7
ensure_line /etc/login.defs PASS_WARN_AGE 14
if [[ -f /etc/default/useradd ]]; then backup_file /etc/default/useradd; ensure_line /etc/default/useradd INACTIVE 30; fi

# Shell idle timeout. Ensure TMOUT assignment is present in both locations.
install -d -m 0755 /etc/profile.d
cat > /etc/profile.d/tmout.sh <<'TMOUT'
TMOUT=900
export TMOUT
TMOUT
chmod 0644 /etc/profile.d/tmout.sh
backup_file /etc/bashrc
if grep -Eq '^[[:space:]]*(readonly[[:space:]]+)?TMOUT=' /etc/bashrc; then sed -ri 's/^[[:space:]]*(readonly[[:space:]]+)?TMOUT=.*/TMOUT=900/' /etc/bashrc; else printf '\nTMOUT=900\n' >> /etc/bashrc; fi

while IFS=: read -r user _ uid _; do
  if [[ "$uid" =~ ^[0-9]+$ ]] && (( uid >= 1000 && uid != 65534 )); then chage -m 7 -M 90 -W 14 "$user" || echo "WARNING: chage failed for $user"; fi
done < /etc/passwd
chage -m 7 -M 90 -W 14 root

# 13. Cron restrictions and permissions.
rm -f /etc/cron.deny
if [[ ! -e /etc/cron.allow ]]; then install -o root -g root -m 0640 /dev/null /etc/cron.allow; fi
chown root:root /etc/cron.allow; chmod 0640 /etc/cron.allow
for f in /etc/crontab; do [[ -e "$f" ]] && { chown root:root "$f"; chmod 0600 "$f"; }; done
for d in /etc/cron.d /etc/cron.daily /etc/cron.hourly /etc/cron.monthly /etc/cron.weekly; do [[ -d "$d" ]] && { chown root:root "$d"; chmod 0700 "$d"; }; done

# 14. GRUB permissions. Generate config only if absent.
if [[ ! -e /boot/grub2/grub.cfg ]] && command -v grub2-mkconfig >/dev/null 2>&1; then grub2-mkconfig -o /boot/grub2/grub.cfg; fi
if [[ -e /boot/grub2/grub.cfg ]]; then chown root:root /boot/grub2/grub.cfg; chmod 0600 /boot/grub2/grub.cfg; fi
if [[ -e /boot/grub2/grubenv ]]; then chown root:root /boot/grub2/grubenv; chmod 0600 /boot/grub2/grubenv; fi

# 15. Disable selected services and remove telnet packages if yum is available.
run_if_exists 'disable named' systemctl disable named
run_if_exists 'disable rpcbind' systemctl disable rpcbind
run_if_exists 'stop telnet.socket' systemctl stop telnet.socket
run_if_exists 'disable telnet.socket' systemctl disable telnet.socket
if command -v yum >/dev/null 2>&1; then run_if_exists 'remove telnet packages' yum remove -y telnet telnet-server; elif command -v dnf >/dev/null 2>&1; then run_if_exists 'remove telnet packages' dnf remove -y telnet telnet-server; fi

echo "Completed with any warnings shown above. Review log: $LOG"
echo "IMPORTANT: Validate SSH access, authentication, auditd, mount settings, and application/container networking."

